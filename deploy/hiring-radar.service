[Unit]
Description=Hiring Radar FastAPI Backend
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/hiring-radar
Environment="PATH=/home/ubuntu/hiring-radar/.venv/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/ubuntu/hiring-radar/.venv/bin/uvicorn backend.app.main:app --host 127.0.0.1 --port 8000 --workers 2

# Auto-restart on failure
Restart=always
RestartSec=5s

# Resource limits
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
