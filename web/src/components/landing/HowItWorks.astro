---
import SectionHead from '../SectionHead.astro';
import Figure from '../Figure.astro';
import Icon from '../Icon.astro';

const steps = [
  { figure: 'laptop', title: 'Add Jobly to Chrome', text: 'One click from the Chrome Web Store. No sign-up, no email.' },
  { figure: 'settle', title: 'Choose what you want', text: 'Pick roles like product design or frontend, your experience level, and where you want to work. Change it any time.' },
  { figure: 'relay', title: 'Get fresh matches', text: 'Open the toolbar icon for your list, newest first. When a new match appears, Jobly sends a notification.' },
];
---
<section class="section container how" id="how-it-works" aria-labelledby="how-title">
  <SectionHead eyebrow="How it works" id="how-title" title="Up and running in a minute." center
    lead="Three steps, then Jobly does the checking in the background." />

  <ol class="steps" data-steps>
    <span class="track" aria-hidden="true"><span class="track-fill" data-track></span></span>
    {steps.map((s, i) => (
      <li class="step" data-reveal>
        <div class="art"><Figure name={s.figure} intensity={0.6} /></div>
        <span class="num" aria-hidden="true">{i + 1}</span>
        <h3><span class="sr-only">Step {i + 1}: </span>{s.title}</h3>
        <p>{s.text}</p>
      </li>
    ))}
  </ol>

  <div class="under" data-reveal>
    <span class="under-icon" aria-hidden="true"><Icon name="server" size={18} /></span>
    <p><strong>Behind the scenes.</strong> Every two hours, Jobly’s server reads about 400 career pages and job boards, checks each posting date, and drops anything older than 60 days. Your preferences live in your browser and travel with each request only to pick your matches. The server doesn’t keep them.</p>
  </div>
</section>

<style>
  .steps { list-style: none; padding: 0; margin: 64px 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; position: relative; }
  .track { position: absolute; left: calc(100% / 6); right: calc(100% / 6); top: calc(var(--art-h) + 29px); height: 2px; background: var(--border); border-radius: 2px; }
  .steps { --art-h: 220px; }
  .track-fill { position: absolute; inset: 0; width: 100%; transform: scaleX(var(--progress, 0)); transform-origin: left; background: var(--brand); border-radius: 2px; transition: transform 0.2s linear; }
  .step { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 10px; }
  .art { width: 100%; height: var(--art-h); border-radius: 20px; background: var(--panel); display: grid; place-items: center; overflow: hidden; }
  .art :global([data-figure]) { width: 72%; max-width: 260px; }
  .num { position: relative; z-index: 1; width: 40px; height: 40px; display: grid; place-items: center; border-radius: 50%; background: var(--page); border: 2px solid var(--border-strong);
    font-weight: 600; color: var(--fg); margin-top: 0; transition: border-color 0.4s ease, color 0.4s ease, background-color 0.4s ease; }
  .step.reached .num { border-color: var(--brand); background: var(--brand); color: var(--on-brand); }
  h3 { font-size: 1.25rem; font-weight: 500; letter-spacing: -0.02em; margin-top: 6px; }
  p { color: var(--muted); max-width: 320px; line-height: 1.6; }

  .under { margin: 56px auto 0; max-width: 820px; display: flex; gap: 16px; align-items: flex-start; padding: 20px 24px; border-radius: 16px; border: 1px dashed var(--border-strong); background: var(--page); }
  .under p { max-width: none; font-size: var(--text-md); }
  .under strong { color: var(--fg); font-weight: 600; }
  .under-icon { width: 36px; height: 36px; flex: none; display: grid; place-items: center; border-radius: 10px; background: var(--panel); color: var(--fg); }

  @media (max-width: 900px) {
    .steps { grid-template-columns: 1fr; max-width: 460px; margin-inline: auto; gap: 40px; --art-h: 200px; }
    .track { display: none; }
    .step .num { border-color: var(--brand); background: var(--brand); color: var(--on-brand); }
  }
</style>

<script>
  // The line between the steps fills as the section scrolls through the viewport; each number lights up when reached.
  const list = document.querySelector<HTMLElement>('[data-steps]');
  const fill = document.querySelector<HTMLElement>('[data-track]');
  const steps = list ? [...list.querySelectorAll<HTMLElement>('.step')] : [];
  if (list && fill && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let ticking = false;
    const update = () => {
      ticking = false;
      const r = list.getBoundingClientRect();
      const vh = window.innerHeight;
      const p = Math.min(1, Math.max(0, (vh * 0.8 - r.top) / (r.height * 0.9)));
      fill.style.setProperty('--progress', p.toFixed(3));
      steps.forEach((s, i) => s.classList.toggle('reached', p >= i / (steps.length - 1) - 0.02));
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  } else {
    fill?.style.setProperty('--progress', '1');
    steps.forEach((s) => s.classList.add('reached'));
  }
</script>
