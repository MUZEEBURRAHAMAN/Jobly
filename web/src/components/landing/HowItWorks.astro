---
import Icon from '../Icon.astro';

// The cursor used in all three scenes (decorative).
const cursor = `<svg class="cursor" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4.5 2.8 19.6 11c.7.4.6 1.4-.2 1.6l-6.1 1.8-2.6 5.8c-.3.7-1.4.7-1.6-.1L3.4 4c-.2-.8.4-1.4 1.1-1.2Z" /></svg>`;
---
<section class="section container how" id="how-it-works" aria-labelledby="how-title">
  <header class="head" data-stagger>
    <span class="eyebrow" data-reveal>How it works</span>
    <h2 class="title" id="how-title" data-reveal>Get started with Jobly</h2>
  </header>

  <ol class="steps" data-stagger>
    <!-- 1. install -->
    <li class="step" data-reveal data-play>
      <div class="scene s1" aria-hidden="true">
        <span class="rings"></span>
        <span class="press">
          <span class="cta"><Icon name="chrome" size={17} /> Add to Chrome</span>
          <span class="ripple"></span>
          <Fragment set:html={cursor} />
        </span>
      </div>
      <p class="label">Step 1</p>
      <p class="text">Add Jobly to Chrome from the Chrome Web Store. It’s free and needs no sign-up.</p>
    </li>

    <!-- 2. choose roles -->
    <li class="step" data-reveal data-play>
      <div class="scene s2" aria-hidden="true">
        <div class="window">
          <div class="win-side"><i></i><i></i><i></i></div>
          <div class="win-main">
            <span class="win-title">What are you looking for?</span>
            <span class="opt o1"><span class="tick"><Icon name="check" size={10} /></span>Product design</span>
            <span class="opt o2"><span class="tick"><Icon name="check" size={10} /></span>Frontend</span>
            <span class="opt o3"><span class="tick"><Icon name="check" size={10} /></span>AI / ML</span>
          </div>
          <Fragment set:html={cursor} />
        </div>
      </div>
      <p class="label">Step 2</p>
      <p class="text">Pick the roles you want, your experience level and where you want to work. Change it any time.</p>
    </li>

    <!-- 3. get matches -->
    <li class="step" data-reveal data-play>
      <div class="scene s3" aria-hidden="true">
        <div class="window">
          <div class="note">
            <span class="j">J</span>
            <span class="note-text"><b>3 new matches</b><small>posted in the last hour</small></span>
            <span class="open">Open</span>
          </div>
          <div class="matches">
            <span class="m-row"><span class="m-logo">N</span><span class="m-lines"><i></i><i></i></span><span class="m-when">2h</span></span>
            <span class="m-row"><span class="m-logo">S</span><span class="m-lines"><i></i><i></i></span><span class="m-when">5h</span></span>
          </div>
          <span class="glow"></span>
          <Fragment set:html={cursor} />
        </div>
      </div>
      <p class="label">Step 3</p>
      <p class="text">Open the toolbar icon to see your matches, newest first. Jobly lets you know when a new one appears.</p>
    </li>
  </ol>

  <p class="under" data-reveal>
    <span class="under-icon" aria-hidden="true"><Icon name="server" size={16} /></span>
    <span><strong>Behind the scenes:</strong> every two hours Jobly’s server reads about 400 career pages and job boards, checks each posting date and drops anything older than 60 days. Your preferences stay in your browser and travel with each request only to pick your matches; the server doesn’t keep them.</span>
  </p>
</section>

<style>
  .head { display: flex; flex-direction: column; gap: 14px; }
  .steps { list-style: none; padding: 0; margin: 48px 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }

  /* card: white with a hairline border, the scene inset by 6px like Typebot */
  .step { background: var(--card); border: 1px solid var(--border); border-radius: 18px; padding: 6px 6px 24px; display: flex; flex-direction: column; }
  .label { margin: 22px 18px 0; font-size: var(--text-md); font-weight: 700; letter-spacing: 0.02em; text-transform: uppercase; color: var(--fg); }
  .text { margin: 8px 18px 0; font-size: var(--text-md); line-height: 1.6; color: var(--muted); }

  /* scenes: warm gradients from the brand palette */
  .scene { position: relative; height: 240px; border-radius: 13px; overflow: hidden; isolation: isolate; }
  .s1 { background: radial-gradient(70% 90% at 30% 0%, #fff4d6 0%, transparent 60%), linear-gradient(135deg, #f7a35c 0%, #f06a4f 45%, #e8508a 100%); }
  .s2 { background: radial-gradient(60% 80% at 10% 0%, #fff1e8 0%, transparent 60%), linear-gradient(120deg, #f9b38a 0%, #f07e5a 50%, #d9557e 100%); }
  .s3 { background: radial-gradient(70% 90% at 90% 10%, #ffe6c9 0%, transparent 55%), linear-gradient(225deg, #f8b26a 0%, #ee6d4f 50%, #c94b7c 100%); }
  :global([data-theme='dark']) .s1, :global([data-theme='dark']) .s2, :global([data-theme='dark']) .s3 { filter: saturate(0.85) brightness(0.82); }

  /* the dark app window shared by scenes 2 and 3 */
  .window { position: absolute; left: 7%; right: 7%; top: 26px; bottom: -14px; border-radius: 14px; background: #121214; border: 1px solid rgb(255 255 255 / 0.1);
    box-shadow: 0 20px 40px -16px rgb(40 10 0 / 0.55); display: flex; gap: 10px; padding: 12px; color: #f4f4f5; }
  .win-side { width: 30%; border-radius: 9px; background: #1b1b1f; padding: 12px 10px; display: flex; flex-direction: column; gap: 8px; }
  .win-side i { display: block; height: 6px; border-radius: 4px; background: #2c2c32; } .win-side i:first-child { width: 70%; background: #3a3a42; }
  .win-main { flex: 1; display: flex; flex-direction: column; gap: 7px; padding: 4px 2px; min-width: 0; }
  .win-title { font-size: 11px; color: #a1a1aa; margin-bottom: 2px; }
  .opt { display: flex; align-items: center; gap: 8px; font-size: 12px; padding: 6px 8px; border-radius: 8px; border: 1px solid #2c2c32; background: #18181b; white-space: nowrap; }
  .tick { width: 14px; height: 14px; flex: none; border-radius: 4px; border: 1px solid #52525b; display: grid; place-items: center; color: transparent; }

  /* scene 1: a button in soft rings; the cursor presses it */
  .rings { position: absolute; inset: -40%; background: repeating-radial-gradient(circle at 50% 50%, rgb(255 255 255 / 0.18) 0 2px, transparent 2px 46px); opacity: 0.6; }
  .press { position: absolute; left: 50%; top: 50%; translate: -50% -50%; }
  .cta { position: relative; display: inline-flex; align-items: center; gap: 6px; padding: 11px 18px; border-radius: 10px; font-weight: 600; font-size: 15px; color: #fff;
    background: linear-gradient(180deg, #ef6a3a, #c8410f); box-shadow: 0 1px 0 rgb(255 255 255 / 0.35) inset, 0 10px 22px -8px rgb(120 30 0 / 0.6); }
  .ripple { position: absolute; right: 2px; bottom: -4px; width: 26px; height: 26px; border-radius: 50%; border: 2px solid rgb(255 255 255 / 0.9); opacity: 0; translate: 50% 50%; }

  /* cursor (filled white with a dark outline, like a real pointer) */
  .scene :global(.cursor) { position: absolute; fill: #fff; stroke: #111; stroke-width: 1.6; stroke-linejoin: round; filter: drop-shadow(0 2px 3px rgb(0 0 0 / 0.35)); }
  .s1 :global(.cursor) { right: -14px; bottom: -18px; }
  .s2 :global(.cursor) { left: 52%; top: 64px; }
  .s3 :global(.cursor) { right: 15%; top: 70px; }

  /* scene 3: a notification in the dark window; the cursor opens it */
  .note { position: absolute; left: 12px; right: 12px; top: 14px; display: flex; align-items: center; gap: 10px; padding: 10px; border-radius: 11px; background: #1d1d21; border: 1px solid #2f2f36; }
  .j { width: 28px; height: 28px; flex: none; display: grid; place-items: center; border-radius: 8px; background: #fb923c; color: #111; font-weight: 700; font-size: 13px; }
  .note-text { display: flex; flex-direction: column; flex: 1; min-width: 0; line-height: 1.3; }
  .note-text b { font-size: 12.5px; font-weight: 600; } .note-text small { font-size: 11px; color: #a1a1aa; }
  .open { font-size: 12px; font-weight: 600; padding: 6px 12px; border-radius: 8px; background: linear-gradient(180deg, #ef6a3a, #c8410f); color: #fff; }
  .matches { position: absolute; left: 12px; right: 12px; top: 78px; display: flex; flex-direction: column; gap: 8px; }
  .m-row { display: flex; align-items: center; gap: 10px; padding: 9px 10px; border-radius: 10px; background: #18181b; border: 1px solid #26262b; }
  .m-logo { width: 22px; height: 22px; flex: none; display: grid; place-items: center; border-radius: 6px; border: 1px solid #34343b; font-size: 10px; font-weight: 600; color: #a1a1aa; }
  .m-lines { flex: 1; display: flex; flex-direction: column; gap: 5px; } .m-lines i { display: block; height: 5px; border-radius: 3px; background: #34343b; width: 62%; } .m-lines i + i { width: 38%; background: #2a2a30; }
  .m-when { font-size: 10px; color: #4ade80; }
  .glow { position: absolute; right: 13%; top: 58px; width: 46px; height: 46px; border-radius: 50%; background: radial-gradient(circle, rgb(255 210 170 / 0.9), transparent 70%); opacity: 0; }

  /* ---------- motion (only while the card is on screen; still under "reduce motion") ---------- */
  [data-playing] .s1 .cta { animation: press 3.6s var(--ease-out) infinite; }
  [data-playing] .s1 .ripple { animation: ripple 3.6s ease-out infinite; }
  [data-playing] .s1 :global(.cursor) { animation: aim1 3.6s var(--ease-out) infinite; }
  @keyframes aim1 { 0% { transform: translate(36px, 30px); opacity: 0; } 15% { opacity: 1; } 38%, 100% { transform: none; } }
  @keyframes press { 0%, 40% { transform: none; } 44% { transform: scale(0.95); } 50%, 100% { transform: none; } }
  @keyframes ripple { 0%, 42% { opacity: 0; transform: scale(0.4); } 46% { opacity: 1; } 70%, 100% { opacity: 0; transform: scale(2.2); } }

  [data-playing] .s2 :global(.cursor) { animation: aim2 5.4s var(--ease-out) infinite; }
  [data-playing] .s2 .o1 .tick { animation: tick 5.4s infinite; }
  [data-playing] .s2 .o2 .tick { animation: tick 5.4s infinite 0.9s; }
  [data-playing] .s2 .o3 .tick { animation: tick 5.4s infinite 1.8s; }
  @keyframes aim2 { 0% { transform: translate(0, -2px); } 16%, 28% { transform: translate(-6px, 2px); } 34%, 44% { transform: translate(-14px, 34px); } 50%, 62% { transform: translate(-22px, 66px); } 100% { transform: translate(0, -2px); } }
  @keyframes tick { 0%, 18% { background: transparent; border-color: #52525b; color: transparent; } 22%, 86% { background: #fb923c; border-color: #fb923c; color: #111; } 92%, 100% { background: transparent; border-color: #52525b; color: transparent; } }

  [data-playing] .s3 .note { animation: drop 4.2s var(--ease-out) infinite; }
  [data-playing] .s3 :global(.cursor) { animation: aim3 4.2s var(--ease-out) infinite; }
  [data-playing] .s3 .glow { animation: glow 4.2s ease-out infinite; }
  [data-playing] .s3 .open { animation: press 4.2s var(--ease-out) infinite; }
  @keyframes drop { 0% { opacity: 0; transform: translateY(-16px); } 14%, 84% { opacity: 1; transform: none; } 96%, 100% { opacity: 0; transform: translateY(-8px); } }
  @keyframes aim3 { 0%, 18% { transform: translate(30px, 40px); opacity: 0; } 26% { opacity: 1; } 40%, 100% { transform: translate(0, -24px); } }
  @keyframes glow { 0%, 40% { opacity: 0; transform: scale(0.5) translateY(-24px); } 46% { opacity: 1; } 72%, 100% { opacity: 0; transform: scale(1.4) translateY(-24px); } }
  /* resting state (no animation): the moment after the click */
  .s3 :global(.cursor) { transform: translate(0, -24px); }

  .under { margin-top: 20px; display: flex; gap: 12px; align-items: flex-start; padding: 14px 16px; border-radius: 14px; background: var(--panel); font-size: var(--text-sm); line-height: 1.6; color: var(--muted); }
  .under strong { color: var(--fg); font-weight: 600; }
  .under-icon { width: 28px; height: 28px; flex: none; display: grid; place-items: center; border-radius: 8px; background: var(--card); color: var(--fg); border: 1px solid var(--border); }

  @media (max-width: 900px) { .steps { grid-template-columns: 1fr; max-width: 480px; } }
  @media (prefers-reduced-motion: reduce) { .s2 .tick { background: #fb923c; border-color: #fb923c; color: #111; } }
</style>
