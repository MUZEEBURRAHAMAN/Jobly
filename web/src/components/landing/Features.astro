---
import SectionHead from '../SectionHead.astro';
import Figure from '../Figure.astro';
import Icon from '../Icon.astro';

// Demo rows use the same fictional companies as the extension's screenshots.
const rows = [
  { l: 'N', title: 'Product Designer', co: 'Northwind Labs', when: '2 hours ago', tone: 'fresh' },
  { l: 'C', title: 'Frontend Engineer', co: 'Copperfield AI', when: 'Yesterday', tone: 'fresh' },
  { l: 'S', title: 'Product Manager', co: 'Skylark', when: '5 days ago', tone: '' },
];
const extras = [
  { icon: 'eye-off', title: 'Hide companies', text: 'Mute employers you don’t want to see.' },
  { icon: 'flag', title: 'Report listings', text: 'Flag a fake or expired job in two clicks.' },
  { icon: 'share-2', title: 'Share a job', text: 'Copy a clean link to send to a friend.' },
  { icon: 'wifi-off', title: 'Works offline', text: 'Your last results stay on screen.' },
  { icon: 'moon', title: 'Light and dark', text: 'Follows your system, or pick one.' },
  { icon: 'command', title: 'Keyboard friendly', text: 'Every action works without a mouse.' },
];
---
<section class="shell features-wrap" id="features" aria-labelledby="features-title">
  <div class="panel panel-pad">
    <div class="container inner">
      <SectionHead eyebrow="Features" id="features-title" title="Six tools in one small extension."
        lead="Everything below works the moment you install it. None of it needs an account." />

      <div class="bento" data-stagger>
        <!-- 1. Real posting dates -->
        <article class="tile t-dates" data-reveal data-play>
          <div class="visual">
            <div class="mock list" aria-hidden="true">
              <div class="slot incoming"><div><div class="row new"><span class="logo">T</span><span class="who"><b>UX Designer</b><small>Tidewater</small></span><span class="when fresh">Just now</span></div></div></div>
              {rows.map((r) => (
                <div class="slot"><div><div class="row"><span class="logo">{r.l}</span><span class="who"><b>{r.title}</b><small>{r.co}</small></span><span class:list={['when', r.tone]}>{r.when}</span></div></div></div>
              ))}
              <div class="slot outgoing"><div><div class="row stale"><span class="logo">O</span><span class="who"><b>Senior Designer</b><small>Old Mill Co</small></span><span class="tag-slot"><span class="when old">74 days ago</span><span class="removed">Older than 60 days</span></span></div></div></div>
            </div>
          </div>
          <h3>Real posting dates</h3>
          <p>Every card shows when the employer posted the job. Jobly reads the date from the listing itself, and anything older than 60 days drops off your list.</p>
        </article>

        <!-- 2. Alerts -->
        <article class="tile t-alerts" data-reveal data-play>
          <div class="visual alerts-visual">
            <div class="toolbar" aria-hidden="true"><span class="ext"><span class="j">J</span><span class="badge">3</span></span></div>
            <div class="toast" aria-hidden="true">
              <span class="j big">J</span>
              <span><b>3 new matches</b><small>Northwind Labs, Skylark and 1 other</small></span>
              <em>now</em>
            </div>
          </div>
          <h3>Alerts that don’t nag</h3>
          <p>Jobly checks for new matches every hour or so and sends one grouped notification. Turn it off any time.</p>
        </article>

        <!-- 3. Filters -->
        <article class="tile t-filters" data-reveal data-play>
          <div class="visual">
            <div class="mock filters" aria-hidden="true">
              <span class="f-label">Date posted</span>
              <span class="f-select"><span class="cycle"><i>Any time</i><i>Past week</i><i>Past 24 hours</i></span><Icon name="chevron-down" size={14} /></span>
              <span class="f-count"><span class="cycle"><i>11,355 jobs</i><i>2,053 jobs</i><i>547 jobs</i></span></span>
              <span class="f-pills"><span>Remote only</span><span>Senior</span><span>$120K+</span></span>
            </div>
          </div>
          <h3>Filters you already know</h3>
          <p>Date posted, experience, salary, location and remote, like the filters on LinkedIn.</p>
        </article>

        <!-- 4. Matches -->
        <article class="tile t-match" data-reveal>
          <div class="visual fig"><Figure name="hub" intensity={0.6} /><span class="match-badge" aria-hidden="true"><Icon name="sparkles" size={12} /> Matches you</span></div>
          <h3>Matched to you</h3>
          <p>Pick your roles and level once. Jobs that fit get a “Matches you” badge and land in your For you tab.</p>
        </article>

        <!-- 5. Saved -->
        <article class="tile t-saved" data-reveal data-play>
          <div class="visual">
            <div class="mock job" aria-hidden="true">
              <div class="row"><span class="logo">Q</span><span class="who"><b>Senior Product Designer</b><small>Quill Systems · Remote</small></span></div>
              <div class="job-actions">
                <span class="save"><span class="s-off"><Icon name="bookmark" size={14} /> Save</span><span class="s-on"><Icon name="bookmark-check" size={14} /> Saved</span></span>
                <span class="apply">Apply <Icon name="external-link" size={13} /></span>
              </div>
              <span class="device"><Icon name="laptop" size={13} /> Kept on this device</span>
            </div>
          </div>
          <h3>A shortlist that stays yours</h3>
          <p>Save a job in one click. Jobly keeps a copy on your device, so it stays on your list after the posting comes down.</p>
        </article>

        <!-- 6. Direct apply -->
        <article class="tile t-apply ill-trigger" data-reveal>
          <div class="visual fig"><Figure name="plug" intensity={1} drive="plug" /></div>
          <h3>Apply on the employer’s site</h3>
          <p>Apply opens the original listing, almost always the company’s own careers page. Jobly never stands between you and the application.</p>
        </article>

        <!-- extras -->
        <article class="tile t-extras" data-reveal>
          <h3>And the small things</h3>
          <p class="x-lead">Details that make a daily habit pleasant.</p>
          <ul class="extras">
            {extras.map((x) => (
              <li><span class="x-icon"><Icon name={x.icon} size={18} /></span><span><strong>{x.title}</strong><span>{x.text}</span></span></li>
            ))}
          </ul>
        </article>
      </div>
    </div>
  </div>
</section>

<style>
  .bento { display: grid; grid-template-columns: repeat(6, 1fr); gap: 12px; margin-top: 48px; }
  .tile { background: var(--card); border: 1px solid var(--border); border-radius: 18px; padding: 6px 6px 24px; display: flex; flex-direction: column; min-width: 0; }
  .t-dates { grid-column: span 4; } .t-alerts { grid-column: span 2; }
  .t-filters, .t-match, .t-saved { grid-column: span 2; }
  .t-apply { grid-column: span 3; } .t-extras { grid-column: span 3; padding: 26px 22px 22px; justify-content: flex-start; }
  .visual { position: relative; height: 300px; flex: none; border-radius: 13px; background: var(--panel); display: grid; place-items: center; overflow: hidden; padding: 20px; }
  .visual.fig :global([data-figure]) { width: 78%; max-width: 280px; }
  h3 { margin: 22px 18px 0; font-size: 1.1875rem; font-weight: 500; letter-spacing: -0.015em; color: var(--fg); }
  .tile > p { margin: 8px 18px 0; font-size: var(--text-md); line-height: 1.6; color: var(--muted); }
  .t-extras h3 { margin: 0; }

  /* shared mock bits, drawn like the extension */
  .mock { width: 100%; font-size: 13px; color: var(--fg); }
  .row { display: flex; align-items: center; gap: 10px; background: var(--card); border: 1px solid var(--border); border-radius: 10px; padding: 10px 12px; }
  .logo { width: 28px; height: 28px; flex: none; display: grid; place-items: center; border-radius: 7px; border: 1px solid var(--border); font-weight: 600; font-size: 12px; color: var(--muted); background: var(--card); }
  .who { display: flex; flex-direction: column; min-width: 0; flex: 1; line-height: 1.3; }
  .who b { font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .who small { font-size: 12px; color: var(--subtle); }
  .when { font-size: 12px; color: var(--subtle); white-space: nowrap; }
  .when.fresh { color: var(--success); }

  /* 1. dates: a fresh job slides in at the top while the stale one is tagged, slides out and folds away.
     Each row sits in a grid track that animates 1fr ↔ 0fr, so nothing overlaps while heights change. */
  .list { display: flex; flex-direction: column; max-width: 520px; width: 100%; }
  .slot { display: grid; grid-template-rows: 1fr; }
  .slot > div { min-height: 0; overflow: hidden; }
  .slot .row { margin-bottom: 8px; }
  .incoming { grid-template-rows: 0fr; }
  .incoming .row { opacity: 0; transform: translateY(-10px); }
  .row.new { border-color: color-mix(in srgb, var(--success) 40%, var(--border)); }
  .tag-slot { display: grid; justify-items: end; }
  .tag-slot > * { grid-area: 1 / 1; }
  .when.old { color: var(--danger); }
  .removed { font-size: 11px; font-weight: 500; padding: 3px 8px; border-radius: 999px; white-space: nowrap;
    background: color-mix(in srgb, var(--danger) 12%, var(--card)); color: var(--danger); opacity: 0; transform: scale(0.9); }
  [data-playing] .outgoing { animation: fold-out 8s var(--ease-out) infinite; }
  [data-playing] .stale { animation: leave 8s var(--ease-out) infinite; }
  [data-playing] .stale .when.old { animation: label-out 8s ease infinite; }
  [data-playing] .removed { animation: tag-in 8s var(--ease-out) infinite; }
  [data-playing] .incoming { animation: fold-in 8s var(--ease-out) infinite; }
  [data-playing] .incoming .row { animation: arrive 8s var(--ease-out) infinite; }
  [data-playing] .list { animation: settle 8s ease infinite; }
  @keyframes label-out { 0%, 22% { opacity: 1; } 26%, 100% { opacity: 0; } }
  @keyframes tag-in { 0%, 22% { opacity: 0; transform: scale(0.9); } 27%, 44% { opacity: 1; transform: none; } 50%, 100% { opacity: 0; } }
  @keyframes leave { 0%, 20% { background: var(--card); } 26%, 40% { background: color-mix(in srgb, var(--danger) 6%, var(--card)); opacity: 1; transform: none; }
    50%, 100% { opacity: 0; transform: translateX(28px); background: color-mix(in srgb, var(--danger) 6%, var(--card)); } }
  @keyframes fold-out { 0%, 50% { grid-template-rows: 1fr; } 62%, 100% { grid-template-rows: 0fr; } }
  @keyframes fold-in { 0%, 52% { grid-template-rows: 0fr; } 64%, 100% { grid-template-rows: 1fr; } }
  @keyframes arrive { 0%, 56% { opacity: 0; transform: translateY(-10px); } 68%, 100% { opacity: 1; transform: none; } }
  /* the list fades for a moment while the loop resets, so the restart never jumps */
  @keyframes settle { 0%, 90% { opacity: 1; } 95% { opacity: 0; } 100% { opacity: 1; } }

  /* 2. alerts: a notification drops in and the badge counts */
  .alerts-visual { place-items: center stretch; align-content: center; }
  .toolbar { display: flex; justify-content: flex-end; padding: 2px 4px 16px; }
  .ext { position: relative; }
  .j { width: 24px; height: 24px; display: grid; place-items: center; border-radius: 7px; background: var(--brand); color: var(--on-brand); font-size: 12px; font-weight: 700; }
  .j.big { width: 32px; height: 32px; border-radius: 9px; font-size: 14px; flex: none; }
  .badge { position: absolute; top: -6px; right: -8px; min-width: 16px; height: 16px; padding: 0 4px; border-radius: 999px; background: var(--fg); color: var(--page); font-size: 10px; font-weight: 600; display: grid; place-items: center; }
  .toast { display: flex; gap: 10px; align-items: flex-start; background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 12px; box-shadow: var(--shadow-md); font-size: 13px; line-height: 1.35; }
  .toast > span:not(.j) { display: flex; flex-direction: column; flex: 1; min-width: 0; }
  .toast b { font-weight: 600; } .toast small { color: var(--subtle); font-size: 12px; }
  .toast em { font-style: normal; font-size: 11px; color: var(--subtle); }
  [data-playing] .toast { animation: toast 5.5s var(--ease-out) infinite; }
  [data-playing] .badge { animation: pop 5.5s var(--ease-out) infinite; }
  @keyframes toast { 0% { opacity: 0; transform: translateY(-24px) scale(0.96); } 12%, 78% { opacity: 1; transform: none; } 92%, 100% { opacity: 0; transform: translateY(-12px); } }
  @keyframes pop { 0%, 8% { transform: scale(0); } 16% { transform: scale(1.25); } 22%, 88% { transform: scale(1); } 96%, 100% { transform: scale(0); } }

  /* 3. filters: the date choice and the count change together */
  .filters { display: grid; gap: 10px; max-width: 280px; }
  .f-label { font-size: 12px; color: var(--subtle); }
  .f-select { display: flex; align-items: center; justify-content: space-between; height: 38px; padding: 0 12px; border-radius: 10px; border: 1px solid var(--border-strong); background: var(--card); }
  .f-count { font-size: 20px; font-weight: 500; letter-spacing: -0.02em; height: 28px; }
  .cycle { display: grid; } .cycle i { grid-area: 1 / 1; font-style: normal; opacity: 0; }
  .cycle i:first-child { opacity: 1; }
  [data-playing] .cycle i { animation: cycle 7.5s infinite; }
  [data-playing] .cycle i:nth-child(2) { animation-delay: 2.5s; } [data-playing] .cycle i:nth-child(3) { animation-delay: 5s; }
  [data-playing] .cycle i:first-child { opacity: 0; }
  /* each label overlaps the next one's fade-in, so the field is never empty */
  @keyframes cycle { 0% { opacity: 0; transform: translateY(6px); } 4%, 33.3% { opacity: 1; transform: none; } 37%, 100% { opacity: 0; transform: translateY(-6px); } }
  .f-pills { display: flex; gap: 6px; flex-wrap: wrap; }
  .f-pills span { font-size: 12px; padding: 3px 9px; border-radius: 999px; border: 1px solid var(--border); background: var(--card); color: var(--muted); }

  /* 4. match badge over the figure */
  .match-badge { position: absolute; left: 14px; bottom: 14px; display: inline-flex; align-items: center; gap: 4px; font-size: 12px; font-weight: 500; padding: 4px 9px; border-radius: 999px; background: var(--brand-soft); color: var(--brand); }

  /* 5. saved: the button flips to Saved */
  .job { display: grid; gap: 10px; max-width: 300px; }
  .job-actions { display: flex; justify-content: space-between; }
  .save, .apply { display: inline-flex; align-items: center; gap: 6px; height: 32px; padding: 0 12px; border-radius: 8px; font-size: 13px; font-weight: 500; }
  .save { border: 1px solid var(--border-strong); background: var(--card); display: grid; }
  .save > span { grid-area: 1 / 1; display: inline-flex; align-items: center; gap: 6px; }
  .s-on { opacity: 0; color: var(--brand); }
  .apply { background: var(--ink); color: var(--on-ink); }
  .device { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; color: var(--subtle); }
  [data-playing] .s-off { animation: off 4.5s infinite; } [data-playing] .s-on { animation: on 4.5s infinite; }
  [data-playing] .save { animation: save-press 4.5s infinite; }
  @keyframes off { 0%, 30% { opacity: 1; } 34%, 86% { opacity: 0; } 90%, 100% { opacity: 1; } }
  @keyframes on { 0%, 30% { opacity: 0; } 34%, 86% { opacity: 1; } 90%, 100% { opacity: 0; } }
  @keyframes save-press { 0%, 28% { transform: none; border-color: var(--border-strong); } 31% { transform: scale(0.94); } 35%, 86% { transform: none; border-color: var(--brand); } 90%, 100% { border-color: var(--border-strong); } }

  /* extras: six small tiles that fill the card */
  .tile > .x-lead { margin: 6px 0 0; font-size: var(--text-md); color: var(--muted); }
  .extras { list-style: none; padding: 0; margin-top: 22px; display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
  .extras li { display: flex; gap: 12px; align-items: flex-start; padding: 14px; border-radius: 14px; background: var(--panel); border: 1px solid transparent;
    transition: border-color var(--dur-fast) ease, background-color var(--dur-fast) ease, transform var(--dur) var(--ease-out); }
  .extras li:hover { border-color: var(--border); background: var(--card); transform: translateY(-1px); }
  .extras li > span:last-child { display: flex; flex-direction: column; line-height: 1.35; min-width: 0; }
  .extras strong { font-size: var(--text-md); font-weight: 600; color: var(--fg); }
  .extras li > span:last-child > span { font-size: var(--text-sm); color: var(--subtle); margin-top: 3px; }
  .x-icon { width: 36px; height: 36px; flex: none; display: grid; place-items: center; border-radius: 10px; background: var(--brand-soft); color: var(--brand); }

  @media (max-width: 1000px) {
    .bento { grid-template-columns: repeat(2, 1fr); }
    .t-dates { grid-column: span 2; }
    .t-alerts, .t-filters, .t-match, .t-saved, .t-apply, .t-extras { grid-column: span 1; }
  }
  @media (max-width: 640px) {
    .bento { grid-template-columns: 1fr; }
    .tile { grid-column: auto !important; }
    .extras { grid-template-columns: 1fr; }
  }
</style>
