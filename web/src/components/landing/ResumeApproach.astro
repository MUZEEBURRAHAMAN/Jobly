---
import SectionHead from '../SectionHead.astro';
import Icon from '../Icon.astro';

// Why Jobly's resume is different: it starts from the questions a recruiter would ask, keeps the user's own words,
// and checks what a recruiter looks for in the first seconds, on top of the ATS check.
const reasons = [
  { icon: 'circle-help', title: 'Questions first, template second', text: 'Ten questions a recruiter would ask if they had the time: what you built, what you figured out, a decision you owned, people you hired or mentored, the outage you fixed, the side project people use. Each answer becomes one line on your resume.' },
  { icon: 'file', title: 'Your words, not a machine’s', text: 'Jobly tidies an answer (drops the “I”, starts with the verb) and never adds a fact or a number you didn’t write. AI rewording is optional, uses your own key, and a fact check drops anything that isn’t in your profile.' },
  { icon: 'search', title: 'Checked for the first seven seconds', text: 'The score has a “Stands out” part: a specific first line, no borrowed phrases like “drove efficiency”, proof the work exists, ownership, and a result at the top of each role.' },
  { icon: 'check', title: 'Still reads cleanly in an ATS', text: 'Eight one-column templates. The ATS check reads the finished page top to bottom, like a parser reads the PDF, in your browser. Nothing is uploaded.' },
];
const generic = ['optimized processes', 'drove efficiency', 'led projects', 'aligned stakeholders', 'best practices', 'delivered results', 'cross-functional collaboration'];
---
<section class="section container resume-approach" id="resume" aria-labelledby="resume-title">
  <SectionHead eyebrow="Resume" id="resume-title" title="A resume that sounds like you, not like everyone else."
    lead="A recruiter gives a resume a few seconds and looks for three things: what you built, what you figured out, and why they should call you. Most resume tools give you a template and a list of keywords, so everyone ends up sounding the same. Jobly starts with questions." />

  <div class="demo" data-reveal>
    <div class="before">
      <p class="tag">What most resumes say</p>
      <ul class="generic" aria-label="Borrowed phrases">{generic.map((g) => <li>{g}</li>)}</ul>
      <p class="note">Safe, borrowed phrases. Jobly’s score names each one it finds.</p>
    </div>
    <div class="after">
      <p class="tag">What Jobly asks</p>
      <p class="q">When did you fix something under pressure?</p>
      <p class="a"><span class="who">Your answer</span>i fixed a 3am production outage before a $150K client noticed it was down.</p>
      <p class="line"><span class="who">On your resume</span>Fixed a 3am production outage before a $150K client noticed it was down</p>
      <p class="note">Same words, same facts. Placed first in the role, where a recruiter looks.</p>
    </div>
  </div>

  <div class="reasons" data-stagger>
    {reasons.map((r) => (
      <article class="reason" data-reveal>
        <span class="ico"><Icon name={r.icon} size={18} /></span>
        <h3>{r.title}</h3>
        <p>{r.text}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .demo { display: grid; grid-template-columns: 1fr 1.25fr; gap: 12px; margin-top: 48px; }
  .demo > div { background: var(--card); border: 1px solid var(--border); border-radius: 18px; padding: 24px; display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .before { background: var(--panel) !important; }
  .tag { margin: 0; font-size: var(--text-sm); font-weight: 500; color: var(--subtle); letter-spacing: 0.01em; }
  .generic { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .generic li { font-size: var(--text-sm); padding: 4px 10px; border-radius: 999px; border: 1px dashed var(--border-strong); color: var(--muted); text-decoration: line-through; text-decoration-color: var(--subtle); }
  .q { margin: 0; font-size: clamp(1.125rem, 1rem + 0.4vw, 1.3125rem); font-weight: 500; letter-spacing: -0.015em; color: var(--fg); text-wrap: balance; }
  .a, .line { margin: 0; display: flex; flex-direction: column; gap: 4px; font-size: var(--text-md); line-height: 1.55; }
  .a { color: var(--muted); }
  .line { color: var(--fg); font-weight: 500; padding-left: 14px; border-left: 2px solid var(--fg); }
  .who { font-size: var(--text-xs); font-weight: 500; color: var(--subtle); text-transform: uppercase; letter-spacing: 0.06em; }
  .note { margin: auto 0 0; font-size: var(--text-sm); color: var(--subtle); }
  .reasons { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-top: 12px; }
  .reason { background: var(--card); border: 1px solid var(--border); border-radius: 18px; padding: 22px; display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .ico { display: inline-grid; place-items: center; width: 34px; height: 34px; border-radius: 10px; background: var(--brand-soft); color: var(--fg); margin-bottom: 6px; }
  .reason h3 { margin: 0; font-size: 1.0625rem; font-weight: 500; letter-spacing: -0.015em; color: var(--fg); }
  .reason p { margin: 0; font-size: var(--text-sm); line-height: 1.6; color: var(--muted); }
  @media (max-width: 1000px) { .reasons { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 760px) { .demo, .reasons { grid-template-columns: 1fr; } }
</style>
