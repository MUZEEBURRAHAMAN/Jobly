---
import Figure from '../Figure.astro';
import Icon from '../Icon.astro';
import { TOP_FAQS } from '../../lib/faq';

const faqs = TOP_FAQS;
---
<section class="shell faq-wrap" id="faq" aria-labelledby="faq-title">
  <div class="panel panel-pad faq-panel">
    <div class="container layout">
      <div class="intro" data-stagger>
        <span class="eyebrow" data-reveal>FAQ</span>
        <h2 class="title" id="faq-title" data-reveal>Questions, answered.</h2>
        <p class="lead" data-reveal>Short answers to what people ask before installing.</p>
        <div class="q-card" data-reveal>
          <div class="q-art"><Figure name="query" intensity={0.7} /></div>
          <div class="q-foot">
            <span><strong>Still curious?</strong><span>We read every message.</span></span>
            <a class="btn btn-outline btn-sm" href="/support"><Icon name="mail" size={15} />Write to us</a>
          </div>
        </div>
      </div>
      <div class="list" data-stagger>
        {faqs.map((f, i) => (
          <details name="faq" open={i === 0} data-reveal>
            <summary><span>{f.q}</span><span class="plus" aria-hidden="true"><Icon name="plus" size={16} /></span></summary>
            <div class="answer"><p>{f.a}</p></div>
          </details>
        ))}
        <a class="more" href="/faq" data-reveal>See all questions <Icon name="arrow-right" size={14} /></a>
      </div>
    </div>
  </div>
</section>

<style>
  .faq-panel { background:
      radial-gradient(55% 70% at 0% 100%, color-mix(in srgb, var(--blob-1) 50%, transparent), transparent 70%),
      radial-gradient(45% 60% at 100% 0%, color-mix(in srgb, var(--blob-3) 40%, transparent), transparent 70%),
      var(--panel); }
  /* both columns are the same height: the illustration card grows so its bottom meets the question list's bottom */
  .layout { display: grid; grid-template-columns: 1fr 1.4fr; gap: clamp(24px, 4vw, 48px); align-items: stretch; }
  .intro { display: flex; flex-direction: column; gap: 16px; }
  .q-card { flex: 1; min-height: 300px; margin-top: 16px; display: flex; flex-direction: column; border-radius: 20px; background: var(--card); border: 1px solid var(--border); padding: 6px; box-shadow: var(--shadow-sm); }
  .q-art { flex: 1; border-radius: 15px; display: grid; place-items: center; overflow: hidden;
    background: radial-gradient(60% 70% at 50% 45%, var(--brand-soft), transparent 70%), radial-gradient(circle, var(--border) 1px, transparent 1.2px) 0 0 / 18px 18px, var(--panel); }
  .q-art :global([data-figure]) { width: min(68%, 260px); }
  .q-foot { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 16px 14px 10px; }
  .q-foot > span { display: flex; flex-direction: column; line-height: 1.35; }
  .q-foot strong { font-weight: 600; color: var(--fg); } .q-foot > span > span { font-size: var(--text-sm); color: var(--subtle); }

  .list { background: var(--card); border: 1px solid var(--border); border-radius: 20px; padding: 6px 24px; box-shadow: var(--shadow-sm); }
  details { border-bottom: 1px solid var(--border); interpolate-size: allow-keywords; }
  details:last-of-type { border-bottom: 0; }
  summary { list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 20px 0; cursor: pointer; font-size: 1.0625rem; font-weight: 500; color: var(--fg); border-radius: 8px; }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--brand); }
  .plus { width: 28px; height: 28px; flex: none; display: grid; place-items: center; border-radius: 50%; background: var(--panel); color: var(--fg); transition: transform var(--dur) var(--ease-out), background-color var(--dur-fast) ease; }
  details[open] .plus { transform: rotate(45deg); background: var(--brand-soft); color: var(--brand); }
  details::details-content { height: 0; overflow: clip; transition: height 0.35s var(--ease-out), content-visibility 0.35s allow-discrete; }
  details[open]::details-content { height: auto; }
  .answer p { color: var(--muted); line-height: 1.7; padding-bottom: 20px; max-width: 62ch; }
  .more { display: inline-flex; align-items: center; gap: 6px; padding: 16px 0 18px; font-weight: 500; color: var(--fg); border-top: 1px solid var(--border); width: 100%; }
  .more:hover { color: var(--brand); }

  @media (max-width: 900px) {
    .layout { grid-template-columns: 1fr; }
    .q-card { min-height: 0; flex: none; }
    .q-art { display: none; }
    .q-foot { padding: 10px 8px; }
    .list { padding: 4px 18px; }
  }
  @media (prefers-reduced-motion: reduce) { details::details-content { transition: none; } }
</style>
