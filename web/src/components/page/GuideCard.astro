---
// Wrangle-style content card: illustrated thumbnail, category · read time, title, short description.
import Figure from '../Figure.astro';
import Icon from '../Icon.astro';
import type { Guide } from '../../lib/guides';

interface Props { guide: Guide; size?: 'md' | 'lg'; headingLevel?: 'h2' | 'h3' }
const { guide, size = 'md', headingLevel: H = 'h3' } = Astro.props;
const tone = guide.data.category.toLowerCase().replace(/\s+/g, '-');
---
<article class:list={['g-card', size]} data-cat={guide.data.category} data-reveal>
  <div class:list={['thumb', `tone-${tone}`]}><Figure name={guide.data.figure} intensity={0.55} /></div>
  <div class="g-body">
    <p class="meta"><span class="cat">{guide.data.category}</span><span aria-hidden="true">·</span><span>{guide.minutes} min read</span></p>
    <H class="g-title"><a href={guide.href}>{guide.data.title}</a></H>
    <p class="g-desc">{guide.data.description}</p>
    {size === 'lg' && <span class="g-more" aria-hidden="true">Read the guide <Icon name="arrow-right" size={15} class="arrow" /></span>}
  </div>
</article>

<style>
  .g-card { position: relative; display: flex; flex-direction: column; gap: 16px; padding: 10px 10px 20px; border-radius: 20px; background: var(--card); border: 1px solid var(--border);
    transition: border-color var(--dur) ease, box-shadow var(--dur) ease, translate var(--dur) var(--ease-out); }
  .g-card:hover { border-color: var(--border-strong); box-shadow: var(--shadow-md); translate: 0 -2px; }
  .g-card:has(a:focus-visible) { box-shadow: var(--ring); }
  .thumb { aspect-ratio: 16 / 10; border-radius: 14px; display: grid; place-items: center; overflow: hidden; --tone: var(--blob-2);
    background: radial-gradient(80% 90% at 70% 10%, color-mix(in srgb, var(--tone) 85%, transparent), transparent 70%), var(--panel); }
  .tone-search-tips { --tone: var(--blob-1); }
  .tone-roles { --tone: var(--blob-2); }
  .tone-tools { --tone: var(--blob-3); }
  .tone-privacy { --tone: color-mix(in srgb, var(--success) 22%, var(--panel)); }
  .thumb :global([data-figure]) { width: 62%; max-width: 280px; }
  .g-body { display: flex; flex-direction: column; gap: 8px; padding-inline: 10px; flex: 1; }
  .meta { display: flex; gap: 6px; font-size: var(--text-sm); color: var(--subtle); }
  .cat { color: var(--brand); font-weight: 500; }
  .g-title { font-size: 1.1875rem; line-height: 1.3; font-weight: 500; letter-spacing: -0.02em; color: var(--fg); text-wrap: balance; }
  .g-title a::after { content: ''; position: absolute; inset: 0; border-radius: 20px; } /* whole card is the link */
  .g-title a:focus-visible { box-shadow: none; }
  .g-desc { color: var(--muted); line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .g-more { margin-top: auto; padding-top: 8px; display: inline-flex; align-items: center; gap: 6px; font-weight: 500; color: var(--fg); }
  .g-more :global(.arrow) { transition: transform var(--dur) var(--ease-out); }
  .g-card:hover .g-more :global(.arrow) { transform: translateX(3px); }

  /* featured: thumbnail beside the text */
  .lg { display: grid; grid-template-columns: 1.15fr 1fr; align-items: center; gap: 28px; padding: 10px 28px 10px 10px; }
  .lg .thumb { aspect-ratio: 16 / 11; }
  .lg .g-title { font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem); letter-spacing: -0.03em; }
  .lg .g-desc { -webkit-line-clamp: 3; font-size: var(--text-lg); }
  .lg .g-body { padding-block: 16px; justify-content: center; }
  .lg .g-more { margin-top: 8px; }
  @media (max-width: 760px) { .lg { grid-template-columns: 1fr; padding: 10px 10px 20px; gap: 16px; } .lg .g-body { padding-block: 0; } }
</style>
