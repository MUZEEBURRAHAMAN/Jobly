---
import Icon from './Icon.astro';
import { MENUS, NAV_LINKS, installHref } from '../lib/site';
---
<header class="site-header" data-header>
  <div class="shell">
    <div class="bar">
      <a class="logo" href="/">
        <span class="mark" aria-hidden="true">J</span>
        <span class="word">Jobly</span>
      </a>

      <nav class="main-nav" aria-label="Main">
        <ul class="nav-list">
          {MENUS.map((menu) => (
            <li class="has-menu" data-menu-root>
              <button class="nav-btn" type="button" aria-expanded="false" aria-controls={`menu-${menu.id}`} data-menu-trigger>
                {menu.label}<Icon name="chevron-down" size={14} class="chev" />
              </button>
              <div class="mega" id={`menu-${menu.id}`} data-menu>
                <ul class="mega-items">
                  {menu.items.map((item) => (
                    <li>
                      <a class="mega-item" href={item.href}>
                        <span class="mega-icon"><Icon name={item.icon} size={16} /></span>
                        <span><span class="mega-label">{item.label}</span><span class="mega-text">{item.text}</span></span>
                      </a>
                    </li>
                  ))}
                </ul>
                <div class="mega-preview" aria-hidden="true">
                  {menu.id === 'product' ? (
                    <div class="preview-shot">
                      <img class="only-light" src="/img/dashboard-jobs-light.webp" srcset="/img/dashboard-jobs-light-720.webp 720w, /img/dashboard-jobs-light.webp 1440w" sizes="420px" alt="" width="1440" height="900" loading="lazy" decoding="async" />
                      <img class="only-dark" src="/img/dashboard-jobs-dark.webp" srcset="/img/dashboard-jobs-dark-720.webp 720w, /img/dashboard-jobs-dark.webp 1440w" sizes="420px" alt="" width="1440" height="900" loading="lazy" decoding="async" />
                    </div>
                  ) : (
                    <div class="preview-live">
                      <span class="live-dot"></span>
                      <div class="live-art" data-live-art></div>
                      <span class="live-num" data-live-stat="tech_jobs_today">140</span>
                      <span class="live-cap">tech jobs posted in the last 24 hours</span>
                    </div>
                  )}
                  <p class="preview-title">{menu.preview.title}</p>
                  <p class="preview-text">{menu.preview.text}</p>
                </div>
              </div>
            </li>
          ))}
          {NAV_LINKS.map((l) => <li><a class="nav-btn" href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>

      <div class="actions">
        <button class="icon-btn" type="button" data-theme-toggle aria-label="Switch to dark theme">
          <Icon name="moon" size={16} class="when-light" />
          <Icon name="sun" size={16} class="when-dark" />
        </button>
        <a class="btn btn-ghost btn-sm hide-sm" href="/support">Support</a>
        <a class="btn btn-ink btn-sm" href={installHref}><Icon name="chrome" size={16} />Add to Chrome</a>
        <button class="icon-btn menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu" data-mobile-toggle>
          <Icon name="menu" size={18} class="when-closed" />
          <Icon name="x" size={18} class="when-open" />
        </button>
      </div>
    </div>
  </div>

  <div class="mobile-sheet" id="mobile-menu" data-mobile-sheet>
    <div class="shell">
      {MENUS.map((menu) => (
        <section class="m-group" aria-label={menu.label}>
          <p class="m-head">{menu.label}</p>
          <ul>{menu.items.map((item) => <li><a class="m-link" href={item.href}><Icon name={item.icon} size={16} />{item.label}</a></li>)}</ul>
        </section>
      ))}
      <section class="m-group" aria-label="More">
        <ul>{NAV_LINKS.map((l) => <li><a class="m-link" href={l.href}><Icon name="building-2" size={16} />{l.label}</a></li>)}</ul>
      </section>
      <a class="btn btn-ink btn-lg m-cta" href={installHref}><Icon name="chrome" size={18} />Add to Chrome, it's free</a>
    </div>
  </div>
</header>

<script>
  import '../scripts/nav';
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; padding-block: 8px; transition: background-color var(--dur) ease, box-shadow var(--dur) ease, backdrop-filter var(--dur) ease; }
  .site-header[data-scrolled] { background: var(--overlay); backdrop-filter: saturate(1.6) blur(28px); -webkit-backdrop-filter: saturate(1.6) blur(28px); box-shadow: 0 1px 0 var(--border); }
  .bar { height: 48px; display: flex; align-items: center; gap: 24px; padding-inline: calc(var(--edge) - var(--gutter)); }
  .logo { display: inline-flex; align-items: center; gap: 10px; font-weight: 600; font-size: 1.125rem; letter-spacing: -0.02em; border-radius: 8px; }
  .mark { width: 28px; height: 28px; display: grid; place-items: center; border-radius: 8px; background: var(--brand); color: var(--on-brand); font-size: 0.9375rem; font-weight: 700; }

  .main-nav { flex: 1; }
  .nav-list { display: flex; align-items: center; gap: 2px; list-style: none; padding: 0; }
  .has-menu { position: relative; }
  .nav-btn { display: inline-flex; align-items: center; gap: 4px; height: 34px; padding: 0 10px; border-radius: var(--radius-btn); font-size: var(--text-md); color: var(--muted);
    transition: color var(--dur-fast) ease, background-color var(--dur-fast) ease; }
  .nav-btn:hover, .nav-btn[aria-expanded='true'] { color: var(--fg); background: var(--card-muted); }
  .nav-btn :global(.chev) { transition: transform var(--dur) var(--ease-out); }
  .nav-btn[aria-expanded='true'] :global(.chev) { transform: rotate(180deg); }

  .mega { position: absolute; top: calc(100% + 10px); left: -10px; width: 720px; display: grid; grid-template-columns: 1fr 260px; gap: 8px; padding: 8px;
    border-radius: 16px; background: var(--card); border: 1px solid var(--border); box-shadow: var(--shadow-lg);
    opacity: 0; transform: translateY(-6px) scale(0.98); transform-origin: top left; visibility: hidden;
    transition: opacity var(--dur-fast) ease, transform var(--dur) var(--ease-out), visibility 0s linear var(--dur); }
  .mega[data-open] { opacity: 1; transform: none; visibility: visible; transition: opacity var(--dur-fast) ease, transform var(--dur) var(--ease-out), visibility 0s; }
  .mega-items { list-style: none; padding: 4px; display: grid; gap: 2px; }
  .mega-item { display: flex; gap: 12px; align-items: flex-start; padding: 10px; border-radius: 10px; transition: background-color var(--dur-fast) ease; }
  .mega-item:hover, .mega-item:focus-visible { background: var(--card-muted); }
  .mega-icon { width: 32px; height: 32px; flex: none; display: grid; place-items: center; border-radius: 8px; background: var(--panel); color: var(--fg); border: 1px solid var(--border); }
  .mega-item:hover .mega-icon { color: var(--brand); }
  .mega-label { display: block; font-size: var(--text-md); font-weight: 500; color: var(--fg); line-height: 1.3; }
  .mega-text { display: block; font-size: var(--text-sm); color: var(--subtle); line-height: 1.45; margin-top: 2px; }
  .mega-preview { border-radius: 12px; background: var(--panel); padding: 14px; display: flex; flex-direction: column; gap: 4px; }
  .preview-shot { border-radius: 8px; overflow: hidden; border: 1px solid var(--border); aspect-ratio: 16 / 11; margin-bottom: 10px; background: var(--card); }
  .preview-shot img { width: 240%; max-width: none; height: auto; } /* zoom into the top-left: sidebar, stats and first cards stay readable */
  .preview-live { flex: 1; min-height: 150px; border-radius: 8px; border: 1px solid var(--border); background: var(--card); margin-bottom: 10px;
    display: flex; flex-direction: column; justify-content: flex-end; padding: 16px; gap: 2px; position: relative; }
  .live-art { flex: 1; min-height: 120px; margin: -4px -8px 8px; }
  .live-dot { position: absolute; top: 14px; right: 14px; width: 8px; height: 8px; border-radius: 50%; background: var(--success); box-shadow: 0 0 0 4px color-mix(in srgb, var(--success) 18%, transparent); }
  .live-num { font-size: 2.25rem; font-weight: 500; letter-spacing: -0.03em; line-height: 1.1; color: var(--fg); font-variant-numeric: tabular-nums; }
  .live-cap { font-size: var(--text-sm); color: var(--subtle); }
  .preview-title { font-size: var(--text-sm); font-weight: 500; color: var(--fg); }
  .preview-text { font-size: var(--text-sm); color: var(--subtle); line-height: 1.45; }

  .actions { display: flex; align-items: center; gap: 6px; }
  .icon-btn { width: 34px; height: 34px; display: grid; place-items: center; border-radius: var(--radius-btn); color: var(--muted); transition: color var(--dur-fast) ease, background-color var(--dur-fast) ease; }
  .icon-btn:hover { color: var(--fg); background: var(--card-muted); }
  /* sun and moon cross over with a quarter turn */
  [data-theme-toggle] { position: relative; }
  [data-theme-toggle] :global(.when-light), [data-theme-toggle] :global(.when-dark) { position: absolute; transition: transform 0.5s var(--ease-out), opacity 0.3s ease; }
  :global([data-theme='light']) [data-theme-toggle] :global(.when-dark) { opacity: 0; transform: rotate(-90deg) scale(0.4); }
  :global([data-theme='dark']) [data-theme-toggle] :global(.when-light) { opacity: 0; transform: rotate(90deg) scale(0.4); }
  .menu-toggle { display: none; }
  .menu-toggle :global(.when-open) { display: none; }
  .menu-toggle[aria-expanded='true'] :global(.when-open) { display: block; }
  .menu-toggle[aria-expanded='true'] :global(.when-closed) { display: none; }

  .mobile-sheet { display: none; }

  @media (max-width: 920px) {
    .main-nav, .hide-sm { display: none; }
    .bar { justify-content: space-between; }
    .menu-toggle { display: grid; }
    .mobile-sheet { display: block; position: fixed; inset: 64px 0 0; padding-inline: calc(var(--edge) - var(--gutter) - 8px); background: var(--page); overflow-y: auto; padding: 8px 0 32px;
      opacity: 0; visibility: hidden; transform: translateY(-8px); transition: opacity var(--dur-fast) ease, transform var(--dur) var(--ease-out), visibility 0s linear var(--dur); }
    .mobile-sheet[data-open] { opacity: 1; visibility: visible; transform: none; transition: opacity var(--dur-fast) ease, transform var(--dur) var(--ease-out), visibility 0s; }
    .m-group { padding: 12px 8px; border-bottom: 1px solid var(--border); }
    .m-group ul { list-style: none; padding: 0; }
    .m-head { font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.08em; color: var(--subtle); font-weight: 600; padding: 4px 8px 8px; }
    .m-link { display: flex; align-items: center; gap: 12px; padding: 12px 8px; border-radius: 10px; font-size: 1rem; color: var(--fg); }
    .m-link:hover { background: var(--card-muted); }
    .m-cta { width: 100%; margin-top: 20px; }
  }
  @media (max-width: 380px) { .actions .btn-ink { display: none; } }
</style>
