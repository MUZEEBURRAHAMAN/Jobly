---
import Icon from './Icon.astro';
---
<div class="shell announce-wrap">
  <a class="announce" href="/how-dates-work">
    <span class="announce-tag">New</span>
    <span>Jobs older than 2 months never show up.</span>
    <span class="announce-link">See how we check dates <Icon name="arrow-right" size={14} class="arrow" /></span>
  </a>
</div>

<style>
  .announce-wrap { padding-top: 12px; }
  .announce { display: flex; align-items: center; justify-content: center; gap: 10px; flex-wrap: wrap; padding: 8px 16px; border-radius: 12px;
    background: var(--panel); color: var(--muted); font-size: var(--text-sm); line-height: 1.4; text-align: center;
    transition: background-color var(--dur-fast) ease, color var(--dur-fast) ease; }
  .announce:hover { color: var(--fg); background: var(--card-muted); }
  .announce-tag { font-size: var(--text-xs); font-weight: 600; padding: 2px 8px; border-radius: var(--radius-full); background: var(--brand-soft); color: var(--brand); }
  .announce-link { display: inline-flex; align-items: center; gap: 4px; color: var(--fg); font-weight: 500; }
  .announce:hover :global(.arrow) { transform: translateX(2px); }
  .announce :global(.arrow) { transition: transform var(--dur) var(--ease-out); }
  @media (max-width: 560px) { .announce > span:nth-child(2) { display: none; } }
</style>
