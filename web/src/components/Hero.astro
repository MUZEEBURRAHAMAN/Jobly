---
import Icon from './Icon.astro';
import HeroShowcase from './HeroShowcase.astro';
import { installHref } from '../lib/site';
---
<section class="shell hero-section" aria-labelledby="hero-title">
  <div class="panel hero">
    <div class="hero-bg" aria-hidden="true">
      <span class="blob b1"></span><span class="blob b2"></span><span class="blob b3"></span>
    </div>

    <div class="hero-inner">
      <h1 id="hero-title" class="display rise">Find jobs posted this week,<br class="br-wide" /> not last year.</h1>
      <p class="lead hero-lead rise d1">Jobly lists openings from company career pages with their real posting date, hides anything older than two months, and tells you when a new one matches. No account. Your preferences stay in your browser.</p>
      <div class="ctas rise d2">
        <a class="btn btn-ink btn-lg" href={installHref}><Icon name="chrome" size={18} />Add to Chrome, it's free</a>
        <a class="btn btn-outline btn-lg" href="#how-it-works">See how it works</a>
      </div>
      <p class="small fine rise d2">Free · No account · Works in Chrome</p>
    </div>

    <div class="rise d3"><HeroShowcase /></div>
  </div>
</section>

<style>
  .hero-section { padding-top: 8px; }
  .hero { isolation: isolate; padding-top: clamp(56px, 8vw, 104px); text-align: center; }

  /* soft gradient that fades in and drifts slowly (still under "reduce motion") */
  .hero-bg { position: absolute; inset: 0; z-index: -1; opacity: 0; animation: bg-in 1.4s var(--ease-out) 0.1s forwards; }
  .blob { position: absolute; border-radius: 50%; filter: blur(70px); opacity: var(--blob-opacity); will-change: transform; }
  .b1 { width: 56%; height: 55%; left: -10%; top: 4%; background: var(--blob-1); animation: drift-a 22s ease-in-out infinite alternate; }
  .b2 { width: 50%; height: 50%; right: -8%; top: -12%; background: var(--blob-2); animation: drift-b 26s ease-in-out infinite alternate; }
  .b3 { width: 46%; height: 40%; right: 4%; top: 30%; background: var(--blob-3); animation: drift-a 30s ease-in-out infinite alternate-reverse; }
  .hero-bg::after { content: ''; position: absolute; inset: 0; background: radial-gradient(60% 40% at 50% 22%, color-mix(in srgb, var(--panel) 55%, transparent), transparent 70%); }
  @keyframes bg-in { to { opacity: 1; } }
  @keyframes drift-a { to { transform: translate3d(6%, -4%, 0) scale(1.06); } }
  @keyframes drift-b { to { transform: translate3d(-5%, 6%, 0) scale(0.96); } }

  /* entrance */
  .rise { opacity: 0; transform: translateY(14px); animation: rise 0.8s var(--ease-out) forwards; }
  .d1 { animation-delay: 0.08s; } .d2 { animation-delay: 0.16s; } .d3 { animation-delay: 0.3s; }
  @keyframes rise { to { opacity: 1; transform: none; } }

  .hero-inner { max-width: 780px; margin-inline: auto; padding-inline: 24px; display: flex; flex-direction: column; align-items: center; }
  .hero-lead { margin-top: 20px; max-width: 640px; }
  .ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 32px; }
  .fine { margin-top: 14px; }

  @media (max-width: 640px) {
    .br-wide { display: none; }
    .hero-inner { padding-inline: 16px; }
    .ctas { width: 100%; flex-direction: column; }
    .ctas .btn { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .rise { opacity: 1; transform: none; animation: none; }
    .hero-bg { opacity: 1; animation: none; }
    .blob { animation: none; }
  }
</style>
