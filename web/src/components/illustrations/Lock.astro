---
// A padlock in the hairline style. Open at rest; it snaps shut when its card (.ill-trigger) is hovered or focused,
// or once it scrolls into view on touch screens. Decorative: the card's text says what it means.
---
<svg class="lock" viewBox="0 0 240 200" aria-hidden="true" focusable="false">
  <ellipse class="shadow" cx="128" cy="182" rx="62" ry="7" />
  <g class="shackle">
    <path class="tube-out" d="M101 98 V66 a26 26 0 0 1 52 0 V98" />
    <path class="tube-in" d="M101 98 V66 a26 26 0 0 1 52 0 V98" />
  </g>
  <rect class="depth" x="86" y="98" width="98" height="78" rx="17" />
  <rect class="face" x="76" y="92" width="98" height="78" rx="17" />
  <path class="sheen" d="M88 104 h40" />
  <g class="keyhole"><circle cx="125" cy="124" r="7" /><rect x="122" y="126" width="6" height="18" rx="3" /></g>
  <g class="badge"><circle cx="178" cy="88" r="15" /><path d="M171 88.5 l5 5 l9 -10" /></g>
</svg>

<style>
  .lock { width: 100%; height: auto; display: block; overflow: visible;
    --ln: color-mix(in srgb, var(--fg) 42%, transparent); --plate: var(--card); --shade: var(--card-muted); }
  .shadow { fill: color-mix(in srgb, var(--fg) 8%, transparent); }
  .tube-out { fill: none; stroke: var(--ln); stroke-width: 14; stroke-linecap: round; transition: stroke 0.35s ease; }
  .tube-in { fill: none; stroke: var(--plate); stroke-width: 12; stroke-linecap: round; }
  .depth { fill: var(--shade); stroke: var(--ln); stroke-width: 1; }
  .face { fill: var(--plate); stroke: var(--ln); stroke-width: 1; transition: fill 0.35s ease, stroke 0.35s ease; }
  .sheen { stroke: color-mix(in srgb, var(--fg) 10%, transparent); stroke-width: 2; stroke-linecap: round; }
  .keyhole { fill: var(--ln); transition: fill 0.35s ease; }
  .badge circle { fill: var(--brand); } .badge path { fill: none; stroke: var(--on-brand); stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }

  /* open (rest): the shackle lifts and swings out around its left leg */
  .shackle { transform-box: view-box; transform-origin: 101px 98px; transform: translateY(-20px) rotate(-14deg);
    transition: transform 0.55s cubic-bezier(0.34, 1.56, 0.64, 1); }
  .badge { transform-box: fill-box; transform-origin: center; transform: scale(0); opacity: 0; transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) 0.18s, opacity 0.2s ease 0.18s; }

  /* locked */
  :global(.ill-trigger:hover) .shackle, :global(.ill-trigger:focus-within) .shackle { transform: none; }
  :global(.ill-trigger:hover) .tube-out, :global(.ill-trigger:focus-within) .tube-out { stroke: var(--brand); }
  :global(.ill-trigger:hover) .face, :global(.ill-trigger:focus-within) .face { fill: color-mix(in srgb, var(--brand-soft) 80%, var(--plate)); stroke: color-mix(in srgb, var(--brand) 55%, transparent); }
  :global(.ill-trigger:hover) .keyhole, :global(.ill-trigger:focus-within) .keyhole { fill: var(--brand); }
  :global(.ill-trigger:hover) .badge, :global(.ill-trigger:focus-within) .badge { transform: none; opacity: 1; }
  @media (hover: none) {
    :global(.ill-trigger.in) .shackle { transform: none; transition-delay: 0.6s; }
    :global(.ill-trigger.in) .tube-out { stroke: var(--brand); transition-delay: 0.6s; }
    :global(.ill-trigger.in) .keyhole { fill: var(--brand); transition-delay: 0.6s; }
    :global(.ill-trigger.in) .badge { transform: none; opacity: 1; transition-delay: 0.8s; }
  }
  @media (prefers-reduced-motion: reduce) { .shackle, .badge, .face, .tube-out, .keyhole { transition: none; } }
</style>
