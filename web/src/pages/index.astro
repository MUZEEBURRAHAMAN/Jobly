---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Problem from '../components/landing/Problem.astro';
import Features from '../components/landing/Features.astro';
import HowItWorks from '../components/landing/HowItWorks.astro';
import Benefits from '../components/landing/Benefits.astro';
import JobMap from '../components/landing/JobMap.astro';
import Compare from '../components/landing/Compare.astro';
import Faq from '../components/landing/Faq.astro';
import FinalCta from '../components/landing/FinalCta.astro';
import RelatedGuides from '../components/page/RelatedGuides.astro';
import { getGuides } from '../lib/guides';
import { SITE } from '../lib/site';

const guides = (await getGuides()).filter((g) => g.data.featured).slice(0, 3);
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'Organization', name: 'Jobly', url: SITE.url, logo: `${SITE.url}/img/icon-128.png`, email: SITE.email },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Jobly', url: SITE.url },
  { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'Jobly', applicationCategory: 'BrowserApplication', operatingSystem: 'Chrome',
    description: 'A free Chrome extension that lists tech jobs from company career pages with their real posting date, hides jobs older than 60 days, and alerts you to new matches. No account.',
    url: SITE.url, offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' } },
];
---
<Base description="Jobly is a free Chrome extension that lists jobs from company career pages with their real posting date, hides anything older than two months, and alerts you to new matches. No account.">
  <Hero />
  <Problem />
  <Features />
  <HowItWorks />
  <Benefits />
  <JobMap />
  <Compare />
  <Faq />
  <RelatedGuides guides={guides} title="Related content" lead="Practical help for a faster job search, from finding new jobs early to spotting the ones that aren’t real." />
  <FinalCta secondary={{ label: 'How it works', href: '#how-it-works' }} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Base>
