---
import Base from '../layouts/Base.astro';
import PageHero from '../components/page/PageHero.astro';
import Icon from '../components/Icon.astro';
import { SITE, installHref } from '../lib/site';

const reasons = [
  'I found a job',
  'Not enough jobs in my field',
  'The jobs weren’t relevant',
  'Too many notifications',
  'Something didn’t work',
  'Privacy worries',
  'I only wanted to try it',
  'Another reason',
];
---
<Base title="Jobly was removed" description="Jobly has been removed from Chrome. Tell us in one click why you uninstalled it; it helps us make Jobly better." noindex>
  <PageHero crumbs={[{ label: 'Uninstalled' }]} eyebrow="Uninstalled" title="Jobly was removed." figure="drawer" intensity={0.7}
    lead="Your preferences, saved jobs and alerts were deleted from this browser along with the extension. Would you tell us why you left? It takes ten seconds." />

  <section class="container leave">
    <div class="card">
      <form name="uninstall" method="POST" action={`mailto:${SITE.email}?subject=Why%20I%20uninstalled%20Jobly`} enctype="text/plain" data-form="uninstall-done" data-email={SITE.email} data-subject="Why I uninstalled Jobly">
        <fieldset class="field">
          <legend>Why did you uninstall Jobly?</legend>
          <div class="reasons">
            {reasons.map((r, i) => (
              <label class="reason"><input type="radio" name="reason" value={r} required={i === 0} /><span>{r}</span></label>
            ))}
          </div>
        </fieldset>
        <div class="field">
          <label for="u-note">Anything else? <span class="opt">(optional)</span></label>
          <textarea class="input" id="u-note" name="note" maxlength="1000" placeholder="What would have made Jobly worth keeping?"></textarea>
        </div>
        <div class="submit">
          <button class="btn btn-ink btn-lg" type="submit"><Icon name="send" size={17} />Write the email</button>
          <p class="form-status" data-form-status role="status" aria-live="polite"></p>
        </div>
        <p class="small">This opens your email app with your answer filled in; press Send there. We’ll see the address you send from, and use it only to reply if you asked something. <a href="/privacy#forms-you-can-send-us">Privacy</a></p>
      </form>
      <div class="done" id="uninstall-done" hidden tabindex="-1">
        <span class="done-icon"><Icon name="heart" size={22} /></span>
        <h2>Thank you</h2>
        <p>Your email app should now be open with your answer: press Send there. We read every one. Good luck with your search.</p>
      </div>
    </div>

    <aside class="back">
      <h2>Changed your mind?</h2>
      <p>Reinstall in a few seconds. You’ll need to pick your roles again, because your old settings were removed with the extension.</p>
      <a class="btn btn-outline" href={installHref}><Icon name="chrome" size={16} />Add Jobly to Chrome</a>
      <a class="link" href="/support">Something broke? Tell us <Icon name="arrow-right" size={14} /></a>
    </aside>
  </section>
  <script>import '../scripts/forms';</script>
</Base>

<style>
  .leave { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 48px); align-items: start; padding-block: clamp(40px, 5vw, 72px) var(--section-y); }
  .card { padding: clamp(20px, 3vw, 36px); border-radius: 24px; border: 1px solid var(--border); background: var(--card); box-shadow: var(--shadow-md); }
  form { display: grid; gap: 22px; }
  fieldset { border: 0; padding: 0; min-width: 0; }
  legend { margin-bottom: 10px; }
  .reasons { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .reason { position: relative; display: flex; }
  .reason input { position: absolute; opacity: 0; inset: 0; cursor: pointer; margin: 0; }
  .reason span { flex: 1; padding: 12px 14px 12px 40px; border-radius: 12px; border: 1px solid var(--border-strong); background: var(--card); position: relative;
    transition: border-color var(--dur-fast) ease, background-color var(--dur-fast) ease; }
  .reason span::before { content: ''; position: absolute; left: 14px; top: 50%; width: 16px; height: 16px; translate: 0 -50%; border-radius: 50%; border: 1.5px solid var(--border-strong); background: var(--card);
    transition: border-color var(--dur-fast) ease, box-shadow var(--dur-fast) ease; }
  .reason:hover span { border-color: color-mix(in srgb, var(--fg) 30%, var(--border-strong)); }
  .reason input:checked + span { border-color: var(--brand); background: var(--brand-soft); }
  .reason input:checked + span::before { border-color: var(--brand); box-shadow: inset 0 0 0 4px var(--card), inset 0 0 0 10px var(--brand); }
  .reason input:focus-visible + span { box-shadow: var(--ring); }
  .opt { color: var(--subtle); font-weight: 400; }
  .submit { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .small a { color: var(--muted); text-decoration: underline; text-underline-offset: 3px; }
  .done { display: grid; justify-items: start; gap: 10px; }
  .done:focus { outline: none; box-shadow: none; }
  .done h2 { font-size: 1.5rem; font-weight: 500; letter-spacing: -0.02em; }
  .done p { color: var(--muted); }
  .done-icon { width: 44px; height: 44px; display: grid; place-items: center; border-radius: 50%; background: var(--brand-soft); color: var(--brand); }
  .back { padding: 24px; border-radius: 20px; background: var(--panel); border: 1px solid var(--border); display: grid; justify-items: start; gap: 12px; }
  .back h2 { font-size: 1.25rem; font-weight: 500; letter-spacing: -0.02em; }
  .back p { color: var(--muted); line-height: 1.6; }
  .link { display: inline-flex; align-items: center; gap: 6px; color: var(--brand); font-weight: 500; font-size: var(--text-md); }
  .link:hover { text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 900px) { .leave { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .reasons { grid-template-columns: 1fr; } .submit .btn { width: 100%; } }
</style>
